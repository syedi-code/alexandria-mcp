{
	"name": "alexandria-mcp",
	"version": "1.0.0",
	"description": "An MCP server over a library of books held as PDFs and searchable page by page.",
	"license": "ISC",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/syedi-code/alexandria-mcp.git"
	},
	"keywords": [
		"mcp",
		"model-context-protocol",
		"cloudflare-workers",
		"citations",
		"pdf"
	],
	"main": "./src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./d1": "./src/d1/index.ts",
		"./worker": "./src/worker/index.ts"
	},
	"files": [
		"src",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"dev": "wrangler dev",
		"deploy": "wrangler deploy",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc -b",
		"lint": "eslint .",
		"format": "prettier --write ."
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.30.0",
		"hono": "^4.10.6",
		"jose": "^6.1.3",
		"pdf-lib": "^1.17.1",
		"zod": "^3.25.76"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20260918.1",
		"@eslint/js": "^9.39.1",
		"@types/node": "^26.6.2",
		"eslint": "^9.39.1",
		"eslint-config-prettier": "^10.1.8",
		"prettier": "^3.6.2",
		"typescript": "^5.9.2",
		"typescript-eslint": "^8.47.0",
		"vitest": "^5.0.1",
		"wrangler": "^4.90.0"
	}
}
